# Server
PORT=5000
NODE_ENV=development

# Allow the Next.js frontend to call this API + connect via WebSocket
CORS_ORIGIN=http://localhost:3000

# PostgreSQL connection (use either DATABASE_URL OR the discrete PG* vars below)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/career_connect
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=career_connect

# Auth
JWT_SECRET=replace_this_with_a_long_random_string
JWT_EXPIRES_IN=7d
